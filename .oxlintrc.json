{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "dist",
    "dist-bundle",
    "node_modules",
    "coverage",
    "apps/web/dist",
    "apps/*/dist*",
    "packages/*/dist*"
  ]
}
