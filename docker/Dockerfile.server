# 镜像里不做构建：产物在本地打好（规避 QEMU 交叉编译下 esbuild/rust 的崩溃）
#   pnpm --filter @ps5lb/server bundle
#   pnpm --filter @ps5lb/web build
FROM node:22-alpine

# 国内环境：apk 走阿里云镜像，npm 走 npmmirror
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
    && apk add --no-cache ffmpeg \
    && npm config set registry https://registry.npmmirror.com \
    && npm i -g catbus-cli --no-fund --no-audit

WORKDIR /app
COPY apps/server/dist-bundle/index.mjs ./server.mjs
COPY apps/web/dist ./web

ENV NODE_ENV=production \
    PS5LB_WEB_DIR=/app/web \
    PS5LB_LOG_DIR=/app/logs

EXPOSE 8787 6667 18443
VOLUME ["/app/.ps5lb", "/app/logs"]
CMD ["node", "server.mjs"]
